# Copy to .env and fill in. Not required at all for the read-only data
# pipeline and backtesting — only needed if you add real/demo order
# placement against Kalshi's authenticated endpoints later.

KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://external-api-ws.kalshi.com/trade-api/ws/v2
KALSHI_DEMO_BASE_URL=https://external-api.demo.kalshi.co/trade-api/v2
KALSHI_USE_DEMO=true
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

PGHOST=localhost
PGPORT=5432
PGDATABASE=pred_market_maker
PGUSER=postgres
PGPASSWORD=postgres

RISK_AVERSION=0.1
MAX_POSITION_PER_MARKET=50
MAX_AGGREGATE_EXPOSURE=200
MIN_SPREAD=0.02
MAX_SPREAD=0.15
